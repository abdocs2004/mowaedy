# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/mawaeedy
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mawaeedy?retryWrites=true&w=majority

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ckljkfjelkjir8u84j4njbui4weflmlkndu2
JWT_EXPIRES_IN=7d

# ---- CORS / Cookies ----
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# lax works when frontend and API share a site (or use the Vite proxy). Use "none" (requires HTTPS) for cross-site deployments.
COOKIE_SAMESITE=lax

# Serve the built frontend (frontend/dist) from this server. Use with `npm run build` + `npm start` at the repo root.
SERVE_CLIENT=false

# ---- Business rules ----
TIMEZONE=Africa/Cairo
# Customers can cancel up to this many hours before the appointment
CANCEL_WINDOW_HOURS=2

# ---- Seed (development only) ----
SEED_ADMIN_NAME=مدير المنصة
SEED_ADMIN_EMAIL=admin@mawaeedy.local
SEED_ADMIN_PASSWORD=Admin@12345
